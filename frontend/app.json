{
  "expo": {
    "name": "J.P. The Handyman",
    "slug": "jp-handyman",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "jphandyman",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "Capture photos of repair tasks for AI diagnostics.",
        "NSPhotoLibraryUsageDescription": "Attach job-site photos to your work orders.",
        "NSMicrophoneUsageDescription": "Capture audio notes during diagnostics."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#09090b"
      },
      "edgeToEdgeEnabled": true,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.FLASHLIGHT"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#09090b"
        }
      ],
      "expo-font",
      [
        "expo-camera",
        {
          "cameraPermission": "Capture photos of repair tasks for AI diagnostics.",
          "microphonePermission": "Capture audio notes during diagnostics."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Attach job-site photos to your work orders."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
